# Copy to /etc/bering/rot-migrate.env on bering-prod (not committed).
#
#   sudo cp scripts/migrate-rot-training-docs/rot-migrate.env.sample /etc/bering/rot-migrate.env
#   sudo chown $USER:$USER /etc/bering/rot-migrate.env
#   chmod 600 /etc/bering/rot-migrate.env
#   # edit paths if your home dirs differ
#
# Or skip the env file — defaults are ~/ROT/server and ~/fraBering/server/fileserver/rot

# Standalone ROT server tree
ROT_SOURCE_ROOT=/home/andy/ROT/server

# fraBering persistent ROT document root (repo root, NOT dist/)
FRABERING_ROT_ROOT=/home/andy/fraBering/server/fileserver/rot
