# Copy to rot-backup.env on bering-prod (not committed).
# Used by scripts/rot-backup/backup-rot-pdfs.sh
#
#   cp scripts/rot-backup/rot-backup.env.sample /etc/bering/rot-backup.env
#   chmod 600 /etc/bering/rot-backup.env

# Standalone ROT app server tree on bering-prod
ROT_SERVER_ROOT=/home/andy/ROT/server

# Where daily tarballs are written on bering-prod before push
BACKUP_DIR=/var/backups/rot

# Retention: prod keeps 1 tarball (live files are the source of truth)
PROD_KEEP_COUNT=1
# vultr + dev each keep 3 newest (in case prod is lost or latest tar is bad)
REMOTE_KEEP_COUNT=3

# Space check: abort if free space on BACKUP_DIR filesystem is below this many GB
MIN_FREE_GB=15

# SSH host aliases (from ~/.ssh/config) and destination directory on each
REMOTE_HOSTS="bering-vultr bering-dev"
REMOTE_DIR=/var/backups/rot

# SSH user on remotes (default: same as local $USER)
# REMOTE_USER=andy

# ROT Postgres is backed up separately on dev/vultr — not embedded in PDF tarballs.

# Email on failure (optional; requires mailx/sendmail)
# ALERT_EMAIL=ops@beringair.com
