# Copy to /etc/bering/rot-backup.env on bering-prod (not committed).
#
#   sudo cp scripts/rot-backup/rot-backup.env.sample /etc/bering/rot-backup.env
#   sudo chown $USER:$USER /etc/bering/rot-backup.env
#   chmod 600 /etc/bering/rot-backup.env

# --- Backup source (post Phase 6 cutover) ---
# frabering = canonical fraBering server/fileserver/rot (default)
# standalone = legacy ~/ROT/server (pre-cutover only)
ROT_BACKUP_SOURCE=frabering
FRABERING_ROT_ROOT=/home/andy/fraBering/server/fileserver/rot

# Legacy standalone ROT tree (only if ROT_BACKUP_SOURCE=standalone)
ROT_SERVER_ROOT=/home/andy/ROT/server

# Where daily tarballs are written on bering-prod before push
BACKUP_DIR=/var/backups/rot

# Retention on prod (live files are source of truth)
PROD_KEEP_COUNT=1

# SSH config Host aliases (must match ~/.ssh/config Host lines)
REMOTE_HOSTS="bering-vultr bering-dev"
REMOTE_KEEP_COUNTS="3 1"
REMOTE_KEEP_COUNT=3

# --- SSH (required for cron — cron has no HOME, won't find ~/.ssh/config by default) ---
BACKUP_HOME=/home/andy
SSH_CONFIG=/home/andy/.ssh/config
SSH_IDENTITY_FILE=/home/andy/.ssh/bering_backup
# Leave REMOTE_USER unset when User is set in each Host block in SSH config.
# REMOTE_USER=andy

REMOTE_DIR=/var/backups/rot

# SSH wrapper path (default: alongside backup-rot-pdfs.sh in repo)
# SSH_WRAPPER=/home/andy/fraBering/scripts/rot-backup/rot-backup-ssh.sh

# Space check: abort if free space on BACKUP_DIR filesystem is below this many GB
MIN_FREE_GB=15

# Email on failure (optional; requires mailx/sendmail)
# ALERT_EMAIL=ops@beringair.com
